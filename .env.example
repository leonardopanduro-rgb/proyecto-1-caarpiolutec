# Copy this file to `.env` and replace placeholder values.
# `.env` is ignored by git.

# App
APP_JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_MAIL_FROM=no-reply@carpultec.local

# Google Maps Platform
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# Test DB (used by application-test.properties)
TEST_DB_URL=jdbc:postgresql://localhost:5432/postgres
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=REPLACE_WITH_YOUR_TEST_DB_PASSWORD
PORT=8080
POSTGRES_DB=carpultec
POSTGRES_USER=carpultec_local
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DB_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/carpultec
SPRING_DATASOURCE_USERNAME=carpultec_local
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DB_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JAVA_OPTS=-XX:MaxRAMPercentage=75
